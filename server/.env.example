APP_NAME=health-manage
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/health_manage
# macOS Homebrew 本机 PostgreSQL 通常没有 postgres 角色，
# 请改成你的系统用户名，例如：postgresql+asyncpg://你的用户名@127.0.0.1:5432/health_manage

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 开发时跳过真实微信 code2Session，用固定 openid 登录
WECHAT_MOCK_LOGIN=true
WECHAT_MOCK_OPENID=dev_openid_001
