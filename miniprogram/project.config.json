{
  "description": "项目配置文件：用于设置小程序项目的基础信息",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "package-lock.json" },
      { "type": "folder", "value": "node_modules" },
      { "type": "file", "value": "vitest.config.ts" },
      { "type": "suffix", "value": ".test.ts" }
    ]
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": ["typescript"],
    "condition": false,
    "swc": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "disableSWC": true
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "health-manage",
  "miniprogramRoot": "./",
  "libVersion": "3.7.0",
  "simulatorPluginLibVersion": {},
  "condition": {}
}
