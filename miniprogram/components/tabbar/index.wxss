.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid #eef3ef;
  z-index: 20;
}
.item {
  flex: 1;
  text-align: center;
  line-height: 112rpx;
  color: #6b7c74;
  font-size: 26rpx;
}
.item.on {
  color: #1f6f4a;
  font-weight: 700;
}
