page {
  background: #f6f7f4;
  color: #1c2b24;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 111, 74, 0.06);
}

.btn-primary {
  background: #1f6f4a;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 600;
}

.muted {
  color: #6b7c74;
  font-size: 24rpx;
}

.has-tab {
  padding-bottom: 160rpx;
}
