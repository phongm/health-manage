.title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.wrap { flex-wrap: wrap; }
.chip { padding: 12rpx 24rpx; border-radius: 999rpx; background: #eef3ef; }
.chip.on { background: #1f6f4a; color: #fff; }
.field { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; }
.field input { text-align: right; }
button { margin: 24rpx; }
