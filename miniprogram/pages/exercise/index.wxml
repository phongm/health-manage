<view class="page">
  <view class="card">
    <view class="title">记一笔运动</view>
    <view class="field" bindtap="pickType">
      <text>类型</text>
      <text>{{selectedName}}</text>
    </view>
    <view class="field">
      <text>时长（分钟）</text>
      <input type="number" value="{{duration}}" bindinput="onDuration" />
    </view>
    <view class="row">
      <view class="chip {{intensity === 1 ? 'on' : ''}}" data-value="1" bindtap="onIntensity">轻松</view>
      <view class="chip {{intensity === 2 ? 'on' : ''}}" data-value="2" bindtap="onIntensity">中等</view>
      <view class="chip {{intensity === 3 ? 'on' : ''}}" data-value="3" bindtap="onIntensity">吃力</view>
    </view>
    <button class="btn-primary" bindtap="save">记录</button>
    <view class="muted">消耗按 MET 估算，计入剩余额度时只按 70%。</view>
  </view>
  <view class="card" wx:if="{{logs.length}}">
    <view class="title">今日</view>
    <view class="item" wx:for="{{logs}}" wx:key="id">
      <view>{{item.name}} · {{item.duration_min}} 分钟</view>
      <view>
        <text class="muted">{{item.kcal_burned}} kcal</text>
        <text class="del" data-id="{{item.id}}" bindtap="remove">删除</text>
      </view>
    </view>
  </view>
</view>
