.page { padding-bottom: 48rpx; }
.title { font-size: 36rpx; font-weight: 700; margin-bottom: 24rpx; }
.row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.row.wrap { flex-wrap: wrap; }
.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #eef3ef;
  color: #3d5348;
}
.chip.on { background: #1f6f4a; color: #fff; }
.field { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #eef3ef; }
.field input { text-align: right; }
.kcal { font-size: 56rpx; font-weight: 700; color: #1f6f4a; margin-top: 24rpx; }
.warn { color: #b45309; margin-top: 12rpx; }
.ghost { background: #eef3ef; color: #1f6f4a; border-radius: 999rpx; margin: 24rpx; }
